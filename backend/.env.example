PORT=3100
# Path to 明史 EPUB. Relative paths are resolved against backend/.
BOOK_PATH=./mingshi.epub

# AI provider (any OpenAI-compatible endpoint works)
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_DEFAULT_MODEL=deepseek-v4-pro
AI_MODEL_OPTIONS=deepseek-v4-pro,qwen3.5-plus,kimi-k2.6,MiniMax-M2.5
AI_SMALL_MODEL=deepseek-v4-flash
AI_SMALL_MODEL_OPTIONS=deepseek-v4-flash,qwen3.6-flash

# Optional: separate TTS endpoint (defaults to AI_BASE_URL/AI_API_KEY)
AI_TTS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_TTS_MODEL=qwen3-tts-flash
AI_TTS_VOICE=Ryan
