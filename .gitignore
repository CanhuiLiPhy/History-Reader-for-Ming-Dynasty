# === 依赖 ===
node_modules/

# === 构建产物 ===
frontend/dist/
frontend/tsconfig.tsbuildinfo

# === 运行时缓存（含数据库、拆分EPUB）===
backend/.cache/
backend/src/.cache/
.cache/

# === 敏感文件（API密钥、个人配置）===
backend/.env
CLAUDE.md

# === 私有数据目录 ===
donotpack/
database/
archive/

# === 原始数据源 ===
*.epub
*.sqlite
*.sqlite-wal
*.sqlite-shm

# === 字体文件（商用字库不应入公开仓库；用户由 fetch-fonts 脚本下载） ===
frontend/public/fonts/*.ttf
frontend/public/fonts/*.otf
frontend/public/fonts/*.woff*

# === 内置 Node 运行时（用户自己装；不入仓库） ===
runtime/

# === 发布包 ===
*.zip
*.tar.gz

# === 系统文件 ===
.DS_Store
Thumbs.db
*.swp
*~

# === IDE ===
.idea/
.vscode/
*.code-workspace

# === 日志 ===
*.log
npm-debug.log*
